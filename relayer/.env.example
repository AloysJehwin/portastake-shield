# EVM key that submits transactions: needs RELAYER_ROLE + FEEDER_ROLE on Portaldot, and gas on every bridge chain.
RELAYER_KEY=
# Bridge signer key(s), comma separated. Keep these different from RELAYER_KEY and the deployer.
BRIDGE_SIGNER_KEYS=

# Portaldot has no bridge contract: RELAYER_KEY's wallet pays arrivals, so these limit what it can do.
# BRIDGE_MAX_PAYOUT=10000000      # largest single payout, tUSD base units (10 tUSD)
# BRIDGE_DAILY_CAP=100000000      # most paid per UTC day, tUSD base units (100 tUSD)
# BRIDGE_MAX_TX_TPOT=20           # refuse any transaction costing more tPOT than this
# BRIDGE_TPOT_RESERVE=5           # refuse to drop the wallet below this much tPOT
# BRIDGE_MAX_TX_WEI=10000000000000000   # on other chains: refuse a transaction costing more wei (0.01 ETH)
# BRIDGE_RESERVE_WEI=1000000000000000   # on other chains: keep this much gas in the wallet (0.001 ETH)
# BRIDGE_LOOKBACK_BLOCKS=20000          # where to start scanning a chain with no recorded deployBlock

# Substrate stash that bonds POT. Either a dev URI, or a polkadot.js keystore file + password.
STASH_SURI=
STASH_JSON=
STASH_PASSWORD=
# Address only: lets --dry-run read the stash without holding its key.
STASH_SS58=

# Validators to nominate, comma separated. Default: the active validator set.
NOMINATE=

PORTALDOT_WS=wss://test-node-v3.portaldot.dev
# Override any chain's RPC: RPC_<chainId>=https://...
# RPC_84532=
