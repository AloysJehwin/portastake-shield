# On-chain tools endpoint. Empty = same origin (Vercel functions in production, Vite proxy to `pnpm tools` locally)
VITE_TOOLS_URL=
# Block explorer for tx/address links (Substrate explorer; EVM txs link to their block)
VITE_EXPLORER_URL=https://scanner-testnet-v3.portaldot.dev

# --- Vercel function env (server side, never VITE_) ---
# FACILITATOR_KEY=0x…   settles x402 payments for the on-chain tools and the API gateway
# GATEWAY_SECRET=…      seals gateway API-key headers (defaults to FACILITATOR_KEY)
# BRIDGE_KEY=0x…        the relayer wallet's key; /api/bridge/claim pays transfers from it
# RPC_<chainId>=…       RPC overrides for any bridge chain
